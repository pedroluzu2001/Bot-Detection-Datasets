   "source": [
    "def infer_intent(text):\n",
    "    if not isinstance(text, str) or text.strip() == \"\":\n",
    "        return {label: 0.0 for label in INTENT_LABELS}\n",
    "\n",
    "    result = classifier(\n",
    "        text,\n",
    "        INTENT_LABELS,\n",
    "        multi_label=False\n",
    "    )\n",
    "\n",
    "    return dict(zip(result[\"labels\"], result[\"scores\"]))\n"
   ]
